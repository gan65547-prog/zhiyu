# 本地运行 ops-center、业务 API 在 your-business-host.example 时使用
# 用法1（推荐开发）：复制为 .env 后 docker compose up -d
# 用法2：cp .env.local-remote.example .env 再按需改密钥

# 业务服务根地址（须从本机浏览器/容器能访问）
BUSINESS_BASE_URL=http://your-business-host.example:8000

# 与业务侧环境变量 INTERNAL_API_KEYS 中某一项完全一致（JSON 数组里的字符串）
INTERNAL_API_KEY=change-me-same-as-business

SOURCE_ENV=local-ops-center

# 必须设置唯一随机密钥（至少 32 个字符）和启动管理员密码（至少 12 个字符）
AUTH_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Docker 内访问业务时使用 your-business-host.example
