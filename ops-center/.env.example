APP_NAME=ops-center
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8081
APP_DEBUG=true

# Business service internal admin endpoint
BUSINESS_BASE_URL=http://host.docker.internal:8000
INTERNAL_API_KEY=replace-me
SOURCE_ENV=ops-center-staging
REQUEST_TIMEOUT_SECONDS=10
GATEWAY_READ_RETRY_COUNT=1
GATEWAY_READ_RETRY_BACKOFF_SECONDS=0.2

# 必须设置唯一随机密钥和启动管理员密码，否则服务拒绝启动
AUTH_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# 留空则使用 SQLite（OPS_DB_PATH）；设置后运维用户/角色存 PostgreSQL
# 例：postgresql://ops:ops@postgres:5432/ops_center
OPS_DATABASE_URL=
# SQLite 路径（OPS_DATABASE_URL 为空时生效）
OPS_DB_PATH=./.data/ops_center.db

# 本地 CI/手测 PostgreSQL：pytest tests/test_postgres_db_optional.py 时设置
# RUN_POSTGRES_OPS_TEST=1
# OPS_TEST_DATABASE_URL=postgresql://ops:ops@127.0.0.1:5434/ops_center

# 开发与 CI：pip install -r requirements-dev.txt 后运行 pytest
