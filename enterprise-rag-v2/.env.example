# 应用配置
APP_NAME=Enterprise RAG System
APP_VERSION=2.0.0
DEBUG=false
ENVIRONMENT=production

# 数据库配置
DATABASE_URL=postgresql://postgres:password@localhost:5432/enterprise_rag
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Redis配置
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_TIMEOUT=5

# X OAuth 2.0 PKCE（配置后才显示/启用授权闭环）
# X_OAUTH_CLIENT_ID=
# X_OAUTH_CLIENT_SECRET=
# X_OAUTH_REDIRECT_URI=http://localhost:3000/platform-data
# X_OAUTH_SCOPES=tweet.read tweet.write users.read offline.access

# Qdrant配置
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
QDRANT_VECTOR_SIZE=768

# 认证配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=/app/logs/app.log
LOG_MAX_FILE_SIZE=10485760
LOG_BACKUP_COUNT=5
ELASTICSEARCH_URL=http://localhost:9200

# 安全配置
ALLOWED_ORIGINS=["http://localhost:3000","https://yourdomain.com"]
RATE_LIMIT_PER_MINUTE=100
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/plain","text/markdown"]

# Celery配置
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json

# 第三方集成配置
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
WECOM_CORP_ID=your_wecom_corp_id
WECOM_AGENT_ID=your_wecom_agent_id
WECOM_SECRET=your_wecom_secret

# OpenClaw配置
INTEGRATION_SECRET=your-integration-secret-key-change-in-production
API_URL=http://localhost:8000

# 内部运维 API（/internal/admin，供 ops-center 等调用；须 JSON 数组格式）
# INTERNAL_API_KEYS=["rotate-me-use-strong-random"]
# 仅允许指定来源 IP（当前单机环境：127.0.0.1）；未配置或含 "*" 则放行；当前为精确匹配，非 CIDR
# INTERNAL_IP_WHITELIST=["127.0.0.1"]

# 监控配置
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# LLM配置
# 研究外部搜索为可选能力；必须配置受信任的 JSON 搜索服务端点，结果正文仍由 SafeFetcher 获取
# RESEARCH_SEARCH_ENDPOINT=https://search.example.com/search?q={query}
# RESEARCH_SEARCH_API_KEY=replace-with-search-provider-key
# RESEARCH_ENABLE_LLM=false
# 支持的provider: openai, zhipu
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
# 可选: 自定义API端点 (使用国内服务时需要)
LLM_BASE_URL=https://api.openai.com/v1
# 模型名称 (openai: gpt-3.5-turbo, gpt-4; zhipu: glm-4)
LLM_MODEL=gpt-3.5-turbo
# 生成温度 (0.0-1.0, 越高越随机)
LLM_TEMPERATURE=0.7
# 最大生成token数
LLM_MAX_TOKENS=2000
