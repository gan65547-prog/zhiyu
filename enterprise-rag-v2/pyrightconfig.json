{
  "pythonVersion": "3.14",
  "pythonPlatform": "Darwin",
  "venvPath": ".",
  "venv": ".venv",
  "include": ["."],
  "exclude": [
    "**/__pycache__",
    "**/.venv",
    "**/venv",
    "**/node_modules",
    "**/frontend",
    "**/tests",
    "**/alembic",
    "**/logs",
    "**/static",
    "**/runtime",
    "**/uploads",
    "**/startup",
    "**/templates",
    "**/qdrant_data"
  ],
  "typeCheckingMode": "basic",
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "reportUnusedImport": true,
  "reportUnusedVariable": true,
  "reportUnusedFunction": true,
  "reportGeneralTypeIssues": true,
  "extraPaths": ["."]
}